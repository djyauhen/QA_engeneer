# Список кладётся на backend-проект Vercel, не на фронтенд.
# Имена без префикса qa_project_. После правки нужен Redeploy.

# Продуктовые данные — Neon. Код читает только DATABASE_URL; qa_project_* игнорируются, префикс сам не снимается.
# Скопируйте значение из qa_project_POSTGRES_URL или qa_project_DATABASE_URL (хост с -pooler).
# Не брать qa_project_POSTGRES_URL_NO_SSL и не брать unpooled, если pooled уже есть.
# В примере sslmode=no-verify. Либо оставьте sslmode=require вместе с uselibpqcompat=true.
# Если в строке Neon есть channel_binding=require — уберите. Настоящую строку не коммитьте.
# Пустой DATABASE_URL при STORAGE=neon роняет старт. Неверный хост или TLS:
# 500 {"error":"internal_error"} на GET /catalog уже после логина.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=no-verify

# Один сервисный токен на все вызовы AIO. Уходит только query-параметром token.
AIO_TOKEN=replace-me

# Первый тимлид. Сравнивается в POST /session. Пароль в Neon не копируется.
TL_LOGIN=replace-me
TL_PASSWORD=replace-me

# neon использует DATABASE_URL. memory — локальные опыты без Neon (не продуктовое хранилище).
# На Vercel оставить neon: любое значение, кроме memory, тоже означает neon.
STORAGE=neon

# Локальный каталог распаковки. Файлы, не строки Postgres.
# На Vercel диск деплоя только для чтения, поэтому код пишет в /tmp этого инстанса и WORK_DIR не использует.
# Каталог виден, пока жив тот же инстанс. Другой инстанс превью не откроет.
WORK_DIR=./data/workdir

PORT=3000

# База временного URL стенда. В сохранённый отчёт URL не пишется.
# На Vercel — origin backend-проекта (ссылки превью), не origin фронтенда.
PUBLIC_BASE_URL=http://127.0.0.1:3000

# https-origin фронтенд-проекта Vercel через запятую, без завершающего слэша.
# Пример: https://FRONTEND_PROJECT.vercel.app
FRONTEND_ORIGIN=

# Необязательно. По умолчанию https://app.aio.tech
AIO_BASE_URL=https://app.aio.tech

# Макросы стенда. ТЗ значения не задаёт.
STAND_FORM_HTML=<div data-stand-form="1"></div>
STAND_BRAND_NAME=Brand
# Пусто — origin превью этой проверки ({{cdn}} -> /preview/<check_id>).
STAND_CDN_BASE=

# 1 — запрос каталога при старте и затем каждые 10 минут.
# На Vercel поставьте 0. Платформа сама ставит VERCEL=1 и выключает это; интервал между запросами не тикает.
CATALOG_AUTO_REFRESH=1

# В ТЗ не задано: как часто опрашивать уведомления и сколько опросов составляют одну попытку.
AIO_NOTIFY_POLL_MS=2000
AIO_NOTIFY_POLLS_PER_ATTEMPT=5

# stub (по умолчанию) ничего не вызывает. Тесты должны оставаться на stub.
# Живой DeepSeek: AI_MODE=real, DEEPSEEK_API_KEY (или AI_API_KEY), AI_MODEL=deepseek-flash.
# Chat completions: thinking enabled, reasoning_effort high. В ТЗ раньше фигурировал Qwen.
AI_MODE=stub
DEEPSEEK_API_KEY=replace-me
# Запасной ключ, если DEEPSEEK_API_KEY пуст:
AI_API_KEY=replace-me
AI_MODEL=deepseek-flash
# Необязательная подмена origin. По умолчанию: https://api.deepseek.com
# AI_BASE_URL=https://api.deepseek.com

# stub не запускает Chrome. real запускает CLI lighthouse (только категория performance).
# На Vercel держать stub. Chrome недоступен.
LIGHTHOUSE_MODE=stub
LIGHTHOUSE_CHROME_PATH=

# Стоимость bcrypt для пользователей Neon. Пароль тимлида из env в базу не хешируется.
BCRYPT_ROUNDS=10
