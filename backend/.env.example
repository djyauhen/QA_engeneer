# Set these on the long-lived API host environment, not in the Vercel frontend project.
# Neon serverless Postgres. Product data only. Do not commit a real string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# One service token for every AIO call. Sent only as the query parameter token.
AIO_TOKEN=replace-me

# First team lead. Compared at POST /session. The password is never copied into Neon.
TL_LOGIN=replace-me
TL_PASSWORD=replace-me

# neon uses DATABASE_URL. memory is for local experiments without Neon (not the product store).
STORAGE=neon

# Unpacked landers and temporary zips. Files, not Postgres rows.
WORK_DIR=./data/workdir

PORT=3000

# Base used to build a temporary stand URL. The URL is not written into the stored report.
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Optional. Default is https://app.aio.tech
AIO_BASE_URL=https://app.aio.tech

# Stand macros. The TZ does not prescribe the values.
STAND_FORM_HTML=<div data-stand-form="1"></div>
STAND_BRAND_NAME=Brand
# Empty means the preview origin of this check ({{cdn}} -> /preview/<check_id>).
STAND_CDN_BASE=

# 1 runs the catalog request once at startup and then every 10 minutes.
CATALOG_AUTO_REFRESH=1

# Open in the TZ: how often to poll notifications, and how many polls make one attempt.
AIO_NOTIFY_POLL_MS=2000
AIO_NOTIFY_POLLS_PER_ATTEMPT=5

# stub (default) never calls Google. Tests must keep this.
# Live Gemini: AI_MODE=real, GEMINI_API_KEY (or AI_API_KEY), AI_MODEL=gemini-3.5-flash-lite.
# Official generateContent (not OpenAI-style chat completions). TZ historically named Qwen.
AI_MODE=stub
GEMINI_API_KEY=replace-me
# Fallback if GEMINI_API_KEY is empty:
AI_API_KEY=replace-me
AI_MODEL=gemini-3.5-flash-lite
# Optional origin override. Default: https://generativelanguage.googleapis.com
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
# AI_BASE_URL=https://generativelanguage.googleapis.com

# stub avoids Chrome. real spawns the lighthouse CLI (category performance only).
LIGHTHOUSE_MODE=stub
LIGHTHOUSE_CHROME_PATH=

# bcrypt cost for Neon users. The env team-lead password is not hashed into the database.
BCRYPT_ROUNDS=10
