# Шаблон backend/.env для локального запуска и для VPS. На фронтенд эти значения не кладутся.
# Настоящую строку DATABASE_URL не коммитьте. Код читает только DATABASE_URL.
# Проверяйте сертификат Neon: sslmode=verify-full.
# Если в строке Neon есть channel_binding=require — уберите. Настоящую строку не коммитьте.
# Пустой DATABASE_URL при STORAGE=neon роняет старт. Неверный хост или TLS:
# 500 {"error":"internal_error"} на GET /catalog уже после логина.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full

# Один сервисный токен на все вызовы AIO. Уходит только query-параметром token.
AIO_TOKEN=replace-me

# Первый тимлид. Сравнивается в POST /session. Пароль в Neon не копируется.
TL_LOGIN=replace-me
TL_PASSWORD=replace-me

# Ключ HMAC для отпечатка пароля тимлида. Не равен паролю и не пишется в sessions.
FINGERPRINT_KEY=replace-me

# neon использует DATABASE_URL. memory — локальные опыты без Neon (не продуктовое хранилище).
STORAGE=neon

# Локальный каталог распаковки. Файлы, не строки Postgres.
# Zip проверки лежит в Postgres, поэтому после рестарта превью можно поднять из архива заново.
WORK_DIR=./data/workdir

# Только loopback. Другое значение не даёт процессу стартовать.
LISTEN_HOST=127.0.0.1

PORT=3000

# База временного URL стенда. В сохранённый отчёт URL не пишется.
# Локально оставьте http://127.0.0.1:3000. На VPS — https://bdc-it.uk без порта и без слэша в конце.
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Origin фронтенда через запятую, без завершающего слэша.
# На VPS: https://bdc-it.uk
FRONTEND_ORIGIN=

# Необязательно. Почта для первого выпуска Let's Encrypt. Пусто — выпуск без email.
# На повторном деплое certbot не вызывается, если сертификат уже есть.
# CERTBOT_EMAIL=

# Необязательно. По умолчанию https://app.aio.tech
AIO_BASE_URL=https://app.aio.tech

# Хосты хранилища архивов через запятую. Скачивание original разрешено только с них и с хоста AIO_BASE_URL.
AIO_STORAGE_HOSTS=

# Превью AIO для визуальной проверки ИИ. Не заменяет локальный стенд, статику и Lighthouse.
# POST /api/v1/campaigns/link-generator/data с shuffle_params true, как в UI AIO.
# Из ответа берётся content у «Landing Preview Link», не content_short и не content_slug.
# Если хотя бы один из трёх UUID пуст, ссылка не запрашивается и проверка продолжается без неё.
# В отчёт, снимок и логи ссылка не пишется.
AIO_PREVIEW_CAMPAIGN_UUID=
AIO_PREVIEW_SOURCE_UUID=
AIO_PREVIEW_DOMAIN_UUID=

# Необязательно. Заголовок x-tenant-id только у POST /api/v1/campaigns/link-generator/data.
# На остальные вызовы AIO не ставится. Cookie и Authorization не отправляются.
AIO_TENANT_ID=

# Макросы стенда. ТЗ значения не задаёт.
# Форма по умолчанию содержит поле телефона. Пустое значение, старый пустой div
# и эта строка берут код из стран карточки (NL +31, DE +49, FR +33, PL +48, GB/UK +44).
# Другое значение подставляется как есть. Неизвестный GEO оставляет код пустым.
STAND_FORM_HTML=<form data-stand-form="1"><label for="stand-phone">Tel</label> <span data-stand-dial></span> <input id="stand-phone" type="tel" name="phone" autocomplete="tel"></form>
STAND_BRAND_NAME=Brand
# Пусто — origin превью этой проверки ({{cdn}} -> /preview/<check_id>).
STAND_CDN_BASE=

# 1 — запрос каталога при старте и затем каждые 10 минут. 0 выключает таймер.
CATALOG_AUTO_REFRESH=1

# В ТЗ не задано: как часто опрашивать уведомления и сколько опросов составляют одну попытку.
AIO_NOTIFY_POLL_MS=2000
AIO_NOTIFY_POLLS_PER_ATTEMPT=5

# stub (по умолчанию) ничего не вызывает. Тесты должны оставаться на stub.
# Живой DeepSeek: AI_MODE=real, DEEPSEEK_API_KEY (или AI_API_KEY), AI_MODEL=deepseek-v4-pro.
# Chat completions: thinking enabled, reasoning_effort low, max_tokens 12288.
# В ТЗ раньше фигурировал Qwen.
AI_MODE=stub
DEEPSEEK_API_KEY=replace-me
# Запасной ключ, если DEEPSEEK_API_KEY пуст:
AI_API_KEY=replace-me
# Вердикты чеклиста остаются на AI_MODEL. Кадры читает AI_VISION_MODEL.
AI_MODEL=deepseek-v4-pro
AI_VISION_MODEL=deepseek-flash
# Необязательная подмена origin. По умолчанию: https://api.deepseek.com
# AI_BASE_URL=https://api.deepseek.com

# stub не запускает Chrome. real запускает CLI lighthouse (только категория performance).
# Пока Chrome на сервере нет, оставьте stub.
# Пустой LIGHTHOUSE_CHROME_PATH берёт VISUAL_CHROME_PATH, затем CHROME_PATH.
LIGHTHOUSE_MODE=stub
LIGHTHOUSE_CHROME_PATH=
# Общий путь к Chrome или Edge, если отдельные пути пусты. На Linux обязателен для real.
# CHROME_PATH=

# stub не снимает кадр стенда. real — один JPEG через puppeteer-core и тот же Chrome.
# Пустой VISUAL_CHROME_PATH берёт LIGHTHOUSE_CHROME_PATH. Пока Chrome нет, оставьте stub.
VISUAL_MODE=stub
VISUAL_CHROME_PATH=

# Стоимость bcrypt для пользователей Neon. Пароль тимлида из env в базу не хешируется.
BCRYPT_ROUNDS=10
